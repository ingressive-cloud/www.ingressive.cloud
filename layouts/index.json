{{- $allPages := where .Site.Pages "Kind" "in" (slice "page" "section") -}}
{{- $docs := where $allPages "Section" "docs" -}}
{{- $posts := where $allPages "Section" "posts" -}}
{{- $pages := $docs | append $posts -}}
[
  {{- range $i, $p := $pages -}}
  {{- if $i }},{{ end }}
  {
    "title":   {{ $p.Title | jsonify }},
    "url":     {{ $p.RelPermalink | jsonify }},
    "section": {{ $p.Parent.Title | jsonify }},
    "content": {{ $p.Plain | jsonify }}
  }
  {{- end }}
]
